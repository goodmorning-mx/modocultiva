{
  "name": "goodmorning-mvp-template-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "verify:pwa": "node scripts/verify-pwa-contract.mjs && node scripts/verify-pwa-cache.mjs",
    "verify:navigation": "node scripts/verify-navigation-history.mjs",
    "verify:configurations": "node scripts/verify-life-configurations.mjs",
    "verify:activities": "node scripts/verify-activity-bank.mjs",
    "verify:level": "node scripts/verify-cultiva-level.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "postinstall": "node scripts/prepare-gm-pwa.mjs"
  },
  "dependencies": {
    "@goodmorning/gm-auth": "https://github.com/goodmorning-mx/gm-auth/archive/ecc820afd9f4729a669a690bb24f950826f217c9.tar.gz",
    "@goodmorning/gm-pwa": "https://github.com/goodmorning-mx/gm-pwa/archive/67e08f85f8c12f5953ee819c391bec050e227a64.tar.gz",
    "@vitejs/plugin-react": "5.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.8.3",
    "vite": "7.3.6"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6"
  }
}
